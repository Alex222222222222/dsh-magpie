{
  "name": "@alex222222222222/magpie",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "DSH plugin providing workspace image analysis and dynamic MCP web search tools backed by a configurable Magpie gateway.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alex222222222222/dsh-magpie.git"
  },
  "engines": {
    "dsh": "^0.2.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/self-check.mjs test/client-check.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-fs": "^0.2.0-0",
    "@deepseek-ai/dsh-mcp-client": "^0.2.0-0",
    "@deepseek-ai/dsh-tools": "^0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
